{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DDS typed workflow IR",
  "type": "object",
  "required": ["id", "version", "diagram_type", "nodes", "edges", "e2e", "flow"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "diagram_type": {"enum": ["l0_summary", "l1_partial", "l1_full"]},
    "nodes": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "label", "role"], "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"type": "string", "minLength": 1}, "role": {"enum": ["entity", "process"]}}}},
    "edges": {"type": "array", "items": {"type": "object", "required": ["id", "from", "to", "meaning"], "properties": {"id": {"$ref": "#/$defs/id"}, "from": {"$ref": "#/$defs/id"}, "to": {"$ref": "#/$defs/id"}, "meaning": {"enum": ["execution_flow", "whole_part", "goal_means", "is_a"]}}}},
    "e2e": {"type": "object", "required": ["inputs", "outputs"], "properties": {"inputs": {"$ref": "#/$defs/ids"}, "outputs": {"$ref": "#/$defs/ids"}}},
    "flow": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "partials": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "nodes", "edges"], "properties": {"id": {"$ref": "#/$defs/id"}, "nodes": {"$ref": "#/$defs/ids"}, "edges": {"$ref": "#/$defs/ids"}}}},
    "l0_ref": {"$ref": "#/$defs/l0Ref"},
    "l0_refs": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/l0Ref"}, {"type": "object", "required": ["partial_id", "partial"], "properties": {"partial_id": {"type": "string"}, "partial": {"type": "object", "required": ["id", "nodes", "edges"]}}}]}},
    "approved_partials": {"type": "array", "items": {"type": "object", "required": ["id", "version", "path", "sha256", "decision_ref"], "properties": {"id": {"type": "string"}, "version": {"type": "string"}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "decision_ref": {"type": "string", "minLength": 1}}}},
    "assembly_decision_ref": {"type": "string", "minLength": 1},
    "connections": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
  },
  "allOf": [
    {"if": {"properties": {"diagram_type": {"const": "l0_summary"}}}, "then": {"properties": {"nodes": {"minItems": 3}, "edges": {"minItems": 2}}}},
    {"if": {"properties": {"diagram_type": {"enum": ["l1_partial", "l1_full"]}}}, "then": {"required": ["partials"]}},
    {"if": {"properties": {"diagram_type": {"const": "l1_partial"}}}, "then": {"properties": {"partials": {"maxItems": 1}}}},
    {"if": {"properties": {"diagram_type": {"const": "l1_full"}}}, "then": {"required": ["approved_partials", "assembly_decision_ref"], "properties": {"approved_partials": {"minItems": 2}}}}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"},
    "ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "l0Ref": {"type": "object", "required": ["node_id", "snapshot"], "properties": {
      "node_id": {"$ref": "#/$defs/id"},
      "snapshot": {"type": "object", "required": ["id", "version", "diagram_type", "nodes", "edges", "e2e", "flow"], "properties": {"diagram_type": {"const": "l0_summary"}}}
    }}
  }
}
